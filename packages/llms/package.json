{
  "name": "@grafctory/llms",
  "version": "0.5.0",
  "description": "AI tasks and shared services for @grafctory/llms.",
  "keywords": [
    "typescript",
    "pipeline",
    "ai",
    "llm"
  ],
  "homepage": "https://grafctory.github.io/llms/",
  "bugs": {
    "url": "https://github.com/grafctory/llms/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/llms.git",
    "directory": "packages/llms"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vectors": {
      "@grafctory/source": "./src/vectors.ts",
      "default": "./dist/vectors.js"
    },
    "./quotas": {
      "@grafctory/source": "./src/quotas.ts",
      "default": "./dist/quotas.js"
    },
    "./usage": {
      "@grafctory/source": "./src/usage.ts",
      "default": "./dist/usage.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "build": "ush rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.2",
    "@grafctory/tape": "^0.13.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": null
}
